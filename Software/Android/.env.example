EXPO_PUBLIC_API_URL=https://backendsupporthr.onrender.com
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URL=

# Google OAuth client IDs for APK/AAB builds.
# Android client ID: Google Cloud Console > Credentials > OAuth client ID > Android.
# It must use package com.supporthr.companion and the SHA-1 of the EAS signing certificate.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Web client ID is still used by the web preview and can also be useful for Firebase setup checks.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Only needed if you later build iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
