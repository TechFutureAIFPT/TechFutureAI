# Copy to .env for local development. Never commit the real .env file.

# Dedicated Gemini API key for this service (do NOT reuse a key pasted in chat/logs —
# rotate it in Google AI Studio if it was ever shared in plaintext).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Deep-research feature (POST /api/assistant/deep-research) — real web search via Tavily
# (tavily.com), purpose-built for AI agents. Free tier available.
TAVILY_API_KEY=

# Firebase Admin credentials — reuse the SAME Firebase project as Software/backend/cv-match-api
# so user accounts and Firestore data stay unified. Provide EITHER the single-JSON
# form OR the three separate fields, not both.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Comma-separated list of extra allowed CORS origins (production FE domain(s)).
# localhost and common preview domains (*.vercel.app, *.netlify.app, *.pages.dev,
# *.railway.app, *.onrender.com) are already allowed by default.
ALLOWED_ORIGINS=https://www.aimatching.com.vn,https://aimatching.com.vn

PORT=8080
