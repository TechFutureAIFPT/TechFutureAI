{
  "expo": {
    "name": "Hipo Tools",
    "slug": "hipo-tool",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "scheme": [
      "supporthr",
      "com.supporthr.companion"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Hipo Tools dùng micro để ghi feedback nhanh bằng giọng nói.",
        "NSSpeechRecognitionUsageDescription": "Hipo Tools dùng nhận dạng giọng nói để chuyển feedback phỏng vấn thành ghi chú."
      }
    },
    "android": {
      "package": "com.supporthr.companion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Hipo Tools dùng micro để ghi feedback nhanh bằng giọng nói.",
          "speechRecognitionPermission": "Hipo Tools dùng nhận dạng giọng nói để chuyển feedback phỏng vấn thành ghi chú."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "933209c7-c551-44da-8041-b09ab06d1ae2"
      }
    },
    "owner": "techfutureais-organization"
  }
}
