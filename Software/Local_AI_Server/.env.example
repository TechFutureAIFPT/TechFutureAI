# Local AI Server
HOST=127.0.0.1
PORT=8088

# Ollama general assistant and dedicated CV evaluation profiles
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen2.5-coder:7b
LOCAL_LLM_FALLBACK_MODEL=qwen2.5-coder:7b
LOCAL_LLM_TEMPERATURE=0.1
LOCAL_LLM_TOP_P=0.85
LOCAL_LLM_NUM_CTX=8192
LOCAL_LLM_NUM_PREDICT=2048
LOCAL_LLM_REPEAT_PENALTY=1.15
LOCAL_CV_MODEL=cv-match:7b
LOCAL_CV_NUM_CTX=8192
LOCAL_CV_NUM_PREDICT=2048
LOCAL_CV_TIMEOUT=240
LOCAL_CV_KEEP_ALIVE=10m
LOCAL_CV_SEED=42
LOCAL_CV_TOKENIZER_PATH=
LOCAL_CV_TOKENIZER_MODEL=cv-match:7b
LOCAL_EMBEDDING_MODEL=nomic-embed-text:latest
LOCAL_EMBEDDING_DIMENSION=768

# SQLite; relative paths resolve from this directory
SQLITE_DB_PATH=data/supporthr_local.db
ENABLE_WAL_MODE=true
MAX_CONCURRENT_JOBS=2
JOB_LEASE_SECONDS=3600

# Browser origins allowed to use the local API/admin console
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8088,http://127.0.0.1:8088
ADMIN_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:3010,http://127.0.0.1:3010
ADMIN_EMAIL=hoanphuc135@gmail.com

# Google OAuth for administrator sign-in and the Drive read-only connection.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8088/api/admin/google/callback
LOCAL_AUTH_REDIRECT_URI=http://localhost:8088/api/auth/google/callback
GOOGLE_DRIVE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8088,http://127.0.0.1:8088
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
