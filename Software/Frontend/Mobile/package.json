{
  "name": "support-hr-mobile-v2",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "release:env": "node scripts/check-release-env.mjs",
    "release:check": "npm run release:env && npm run typecheck && npx expo-doctor",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-voice/voice": "^3.2.4",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "expo": "~56.0.17",
    "expo-auth-session": "~56.0.18",
    "expo-constants": "~56.0.25",
    "expo-document-picker": "~56.0.4",
    "expo-image-picker": "~56.0.22",
    "expo-print": "~56.0.4",
    "expo-sharing": "~56.0.26",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.6",
    "firebase": "^12.3.0",
    "lucide-react-native": "^0.553.0",
    "nativewind": "^4.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^56.0.13",
    "patch-package": "^8.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-voice/voice"
        ],
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "expo",
        "expo-image-picker"
      ]
    }
  }
}
